<script>
  const videos = [...document.querySelectorAll<HTMLVideoElement>('video[data-playback-group="hero"]')];
  const button = document.querySelector<HTMLButtonElement>("#hero-playback-toggle");
  const hero = document.querySelector<HTMLElement>(".cinematic-hero");
  const status = document.querySelector<HTMLElement>("#media-status");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
  const connection = (navigator as Navigator & { connection?: { saveData?: boolean; addEventListener?: (type: string, listener: () => void) => void } }).connection;
  let userPaused = false;
  let attemptedAutomaticStart = false;
  let inView = false;
  let request = 0;
  const automaticPauses = new WeakSet<HTMLVideoElement>();
  const update = () => {
    if (button) button.textContent = videos.some((video) => !video.paused && !video.ended) ? "Pause videos" : "Play videos";
  };
  const pause = (automatic: boolean) => {
    request++;
    for (const video of videos) {
      if (!video.paused && automatic) automaticPauses.add(video);
      video.pause();
    }
    button?.removeAttribute("aria-busy");
    update();
  };
  const play = async () => {
    const current = ++request;
    button?.setAttribute("aria-busy", "true");
    const results = await Promise.allSettled(videos.map((video) => video.play()));
    if (current !== request) return;
    if (results.some((result) => result.status === "rejected" && result.reason?.name !== "AbortError") && status)
      status.textContent = "Use Play videos or the native player controls if automatic playback is unavailable.";
    else if (status) status.textContent = "";
    button?.removeAttribute("aria-busy");
    update();
  };
  for (const video of videos) {
    video.muted = true;
    video.addEventListener("play", update);
    video.addEventListener("pause", () => {
      if (automaticPauses.has(video)) automaticPauses.delete(video);
      else if (!video.ended) userPaused = true;
      update();
    });
    video.addEventListener("ended", update);
    video.addEventListener("error", update);
  }
  if (button && hero && videos.length) {
    button.hidden = false;
    button.addEventListener("click", () => {
      if (videos.some((video) => !video.paused) || button.hasAttribute("aria-busy")) {
        userPaused = true;
        pause(false);
      } else {
        userPaused = false;
        attemptedAutomaticStart = true;
        void play();
      }
    });
    const startIfAllowed = () => {
      if (!inView || document.hidden || reduced.matches || connection?.saveData || userPaused || attemptedAutomaticStart) return;
      attemptedAutomaticStart = true;
      void play();
    };
    const observer = new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      if (!inView) pause(true);
      else startIfAllowed();
    }, { threshold: 0 });
    observer.observe(hero.querySelector(".hero-backdrops") || hero);
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) pause(true);
      else startIfAllowed();
    });
    reduced.addEventListener("change", () => { if (reduced.matches) pause(true); });
    connection?.addEventListener?.("change", () => { if (connection.saveData) pause(true); });
    update();
  }
</script>
