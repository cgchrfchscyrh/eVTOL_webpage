---
import site from "../data/site.json";
import { asset } from "../data/paths";
interface Props {
  id: string;
  compact?: boolean;
  concise?: boolean;
  caption?: string;
}
const { id, compact = false, concise = false, caption } = Astro.props;
const fig = site.figures.find((f) => f.id === id)!;
const description = concise
  ? fig.description.replace("Table 6 on this page", "Table 6 on the results page")
  : fig.description;
---

<figure class:list={["research-figure", { compact }]} id={`figure-${id}`}>
  <div class="figure-image">
    <img
      src={asset(`figures/${fig.file}`)}
      width={fig.width}
      height={fig.height}
      style={`max-width:${fig.width}px;aspect-ratio:${fig.width}/${fig.height}`}
      alt={fig.alt}
      loading="lazy"
      decoding="async"
    />
  </div>
  <figcaption>
    <strong>{caption || fig.title}</strong>
    {concise ? <details class="figure-details"><summary>Description & source</summary><p>{description}</p><p class="fine-print">{fig.credit} <a href={asset(`figures/${fig.file}`)}>Open figure {fig.number} at full size</a>.</p></details> : <><p>{description}</p><p class="fine-print">
      {fig.credit}
      <a href={asset(`figures/${fig.file}`)}
        >Open figure {fig.number} at full size</a
      >.
    </p></>}
  </figcaption>
</figure>
