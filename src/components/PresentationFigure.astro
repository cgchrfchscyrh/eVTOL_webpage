---
import presentation from "../data/presentation.json";
import { asset } from "../data/paths";
interface Props {
  id: string;
  concise?: boolean;
}
const { id, concise = false } = Astro.props;
const fig = presentation.figures.find((item) => item.id === id)!;
---

<figure class:list={["research-figure", "presentation-figure", `presentation-${id}`]} id={`presentation-${id}`}>
  <div class="figure-image">
    <img
      src={asset(`figures/presentation/${fig.file}`)}
      width={fig.width}
      height={fig.height}
      alt={fig.alt}
      aria-describedby={`presentation-${id}-description`}
      loading="lazy"
      decoding="async"
    />
  </div>
  <figcaption>
    <strong>{id === "urban-digital-twin" ? "Digital city" : "Urban wind field"}</strong>
    {concise ? <details class="figure-details"><summary>Description & source</summary><p id={`presentation-${id}-description`}>{fig.description}</p><p class="fine-print">{fig.credit} <a href={asset(`figures/presentation/${fig.file}`)}>View {fig.title.toLowerCase()} at full size</a>.</p></details> : <><p id={`presentation-${id}-description`}>{fig.description}</p>
    <p class="fine-print">
      {fig.credit}{" "}
      <a href={asset(`figures/presentation/${fig.file}`)}>View {fig.title.toLowerCase()} at full size</a>.
    </p></>}
  </figcaption>
</figure>
