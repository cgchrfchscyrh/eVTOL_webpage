---
import site from "../data/site.json";
import simulation from "../data/hero-media.json";
import MediaControls from "./MediaControls.astro";
import { asset } from "../data/paths";
---

<section class="hero cinematic-hero" aria-labelledby="paper-title">
  <div class="hero-stage" id="hero-stage">
    <div class="hero-text">
      <p class="eyebrow">FLYING DNA · eVTOL research</p>
      <h1 id="paper-title" class="long-title">{site.title}</h1>
      <p class="hero-question">{site.heroIntro}</p>
      <div class="hero-publication">
        <ul class="authors">
          {site.authors.map((author) => (
            <li><><a href={`mailto:${author.email}`}>{author.name}</a><sup><a href={`#affiliation-${author.aff}`} aria-label={`Affiliation ${author.aff}`}>{author.aff}</a></sup></></li>
          ))}
        </ul>
        <ol class="affiliations">
          {site.affiliations.map((affiliation, i) => <li id={`affiliation-${i + 1}`}>{affiliation}</li>)}
        </ol>
        <p class="hero-venue">{site.venue}</p>
        <div class="actions">
          <a class="button light" href={site.paperUrl}>Read published paper <span aria-hidden="true">↗</span></a>
          <a class="button light" href={site.repo}>{site.repoLabel} <span aria-hidden="true">↗</span></a>
          <a class="button light" href={asset("paper/")}>Explore the research</a>
        </div>
      </div>
    </div>
    <div class="hero-backdrops">
      <video id="context-video" data-playback-group="hero" controls muted playsinline preload="metadata" poster={asset("media/poster.jpg")} width="1280" height="720" aria-label={site.contextTitle} aria-describedby="context-summary context-visual-description">
        <source src={asset("media/context.mp4")} type="video/mp4" />
        <track kind="descriptions" src={asset("media/context-descriptions.vtt")} srclang="en" label="English visual descriptions" />
        <a href={asset("media/context.mp4")}>Download the silent NASA air-taxi context clip (MP4).</a>
      </video>
      <video id="simulation-video" data-playback-group="hero" controls muted playsinline preload="metadata" poster={asset(simulation.poster)} width={simulation.width} height={simulation.height} aria-label={simulation.title} aria-describedby="simulation-summary simulation-visual-description">
        <source src={asset(simulation.video)} type="video/mp4" />
        <track kind="descriptions" src={asset(simulation.track)} srclang="en" label="English visual descriptions" />
        <a href={asset(simulation.video)}>Download the silent urban flight visualization (MP4).</a>
      </video>
    </div>
  </div>
  <div class="hero-scene-captions">
    <div id="context-summary">
      <p class="eyebrow">01 / Air taxis in the real world</p>
      <strong>NASA and Joby flight testing.</strong>
      <p><a href={site.contextUrl}>{site.contextCredit}</a> · {site.contextDuration}-second context clip</p>
    </div>
    <div id="simulation-summary">
      <p class="eyebrow">02 / Urban flight in a digital city</p>
      <strong>{simulation.caption}</strong>
      <p>Flying DNA presentation · {Math.round(simulation.duration)}-second visualization</p>
    </div>
  </div>
  <div class="hero-playback">
    <button class="button light" id="hero-playback-toggle" data-media-control data-idle-label="Play both clips" data-pause-label="Pause clips" data-replay-label="Replay both clips" aria-controls="context-video simulation-video" aria-describedby="hero-playback-note" type="button" hidden>Play both clips</button>
    <button class="button outline" id="hero-view-toggle" aria-controls="hero-stage" aria-pressed="false" type="button" hidden>Show full video frames</button>
    <p id="hero-playback-note">Silent excerpts · Original recording speed · No autoplay · <a href="#media-description">Video descriptions & sources</a></p>
    <p id="media-status" class="sr-only" role="status"></p>
  </div>
</section>
<MediaControls />
