---
import Layout from "../layouts/Layout.astro";
import site from "../data/site.json";
import { asset } from "../data/paths";
---

<Layout title={`Results — ${site.wordmark}`} description="Explore the results on the eVTOL project page." canonicalPath={asset()} noindex>
  <div class="reading-container">
    <header class="page-title">
      <h1>Explore the results</h1>
      <p class="lead">The full numerical results are in the published paper.</p>
      <div class="actions"><a class="button dark" href={site.paperUrl}>Read the paper ↗</a> <a class="button" href={asset("#experiment")}>Go to Experiment</a></div>
    </header>
  </div>
</Layout>
