---
import site from "../data/site.json";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Figure from "../components/Figure.astro";
import DeckFigure from "../components/DeckFigure.astro";
import MotionClip from "../components/MotionClip.astro";
import Citation from "../components/Citation.astro";
---

<Layout title={site.displayTitle} bare>
  <Hero />
  <div class="container visual-research">
    <section class="section deck-section" id="background" aria-labelledby="background-title">
      <h2 id="background-title">Background</h2>
      <p class="deck-lead">Advanced air mobility (AAM) extends city transportation into low-altitude airspace. Because eVTOL aircraft take off and land vertically, they can carry passengers across a city without runways.</p>
      <div class="deck-mosaic wide-media">
        <DeckFigure id="air-mobility" tag="Air mobility" />
        <DeckFigure id="evtol-transport" tag="eVTOL · Transportation" />
        <DeckFigure id="drone-logistics" tag="Drone · Logistics" />
      </div>
    </section>

    <section class="section deck-section" id="problem" aria-labelledby="problem-title">
      <h2 id="problem-title">Problem</h2>
      <p class="deck-lead">Wind between city buildings changes speed and direction over short distances. It pushes an aircraft off its path and raises the energy it needs to stay on course.</p>
      <div class="media-pair wide-media">
        <MotionClip id="problem-wind-simulation" tag="Simulated wind" />
        <MotionClip id="problem-real-flight" tag="Real flight" />
      </div>
    </section>

    <section class="section deck-section" id="method" aria-labelledby="method-title">
      <h2 id="method-title">Methodology</h2>
      <p class="deck-lead">Multi-objective motion planning from origin to destination through urban wind fields. The plan weighs energy use and efficiency for the aircraft, comfort, safety, and flight time for passengers, and noise for people on the ground.</p>
      <div class="method-figure wide-media deck-wide"><Figure id="overview" bare /></div>
      <div class="deck-step">
        <h3>Simulate the city’s wind</h3>
      </div>
      <div class="deck-trio wide-media">
        <DeckFigure id="city" tag="City" />
        <DeckFigure id="cfd" tag="CFD" />
        <MotionClip id="wind-prediction" tag="Wind prediction" />
      </div>
      <div class="deck-step">
        <h3>Train a tailored PPO policy</h3>
      </div>
      <div class="method-figure wide-media deck-wide"><Figure id="framework" bare /></div>
    </section>

    <section class="section deck-section" id="experiment" aria-label="Experiment">
      <p class="deck-lead">An OpenStreetMap model of Atlanta, Georgia. Each trial plans a 10 km flight under one of seven wind conditions.</p>
      <div class="deck-split">
        <DeckFigure id="atlanta-experiment" />
        <p class="deck-split-tags" aria-hidden="true"><span>Atlanta</span><span>CFD</span></p>
      </div>
    </section>
    <Citation />
  </div>
</Layout>
