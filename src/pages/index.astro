---
import stories from "../data/vision-stories.json";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Figure from "../components/Figure.astro";
import PresentationFigure from "../components/PresentationFigure.astro";
import MotionClip from "../components/MotionClip.astro";
import Citation from "../components/Citation.astro";
import evidence from "../data/evidence.json";
---

<Layout title={stories.flight.headline} bare>
  <Hero />
  <div class="container visual-research">
    <section class="section evidence-section" id="context" aria-labelledby="context-title">
      <h2 id="context-title">Cities are congested, and the U.S. is preparing its airspace for air taxis.</h2>
      <div class="evidence-grid">
        {evidence.map(tile => <article class="evidence-tile">
          <h3>{tile.label}</h3>
          <p class="evidence-value">{tile.value}</p>
          <p class="evidence-text">{tile.text}</p>
          <a href={tile.source} aria-label={`Source for ${tile.label}: ${tile.sourceName}`}>Source ↗</a>
        </article>)}
      </div>
    </section>
    <section class="section abstract-section" id="abstract" aria-labelledby="abstract-title">
      <h2 id="abstract-title">From city wind to a flight path</h2>
      <div class="media-pair wide-media">
        <div class="clip-with-bubble">
          <Figure id="overview" bare />
          <p class="clip-bubble"><strong>One flight, three views.</strong> The aircraft, its passengers, and the people below all shape the route.</p>
        </div>
        <div class="clip-with-bubble">
          <MotionClip id="urban-intersection" />
          <p class="clip-bubble"><strong>Over the city.</strong> An aircraft passes above a rendered intersection.</p>
        </div>
      </div>
    </section>
    <section class="section" id="method" aria-labelledby="method-title">
      <h2 id="method-title">How we trained it</h2>
      <div class="wide-media">
        <div class="method-figure"><Figure id="framework" concise caption="Learning motion with multiple flight objectives." /></div>
        <h3 class="sr-only">What the figure shows</h3>
        <div class="method-bubbles">
          <p class="method-bubble"><strong>The city and its wind.</strong> An OpenStreetMap model of Atlanta, with wind fields computed in OpenFOAM.</p>
          <p class="method-bubble"><strong>The policy.</strong> Modified PPO picks continuous motion in three dimensions from position, local wind, and nearby obstacles.</p>
          <p class="method-bubble"><strong>Six objectives.</strong> Energy use, energy efficiency, comfort, safety, flight time, and noise.</p>
        </div>
      </div>
      <div class="presentation-grid wide-media">
        <PresentationFigure id="urban-digital-twin" concise />
        <PresentationFigure id="urban-wind-field" concise />
      </div>
    </section>
    <section class="section" id="results" aria-labelledby="results-title">
      <h2 id="results-title" class="sr-only">Simulation</h2>
      <div class="media-pair wide-media">
        <div class="clip-with-bubble">
          <MotionClip id="urban-corridor" />
          <p class="clip-bubble"><strong>Among buildings.</strong> The aircraft flies toward an intersection surrounded by towers.</p>
        </div>
        <div class="clip-with-bubble">
          <MotionClip id="urban-facade" />
          <p class="clip-bubble"><strong>Beside the facades.</strong> The view moves in close behind the aircraft.</p>
        </div>
      </div>
    </section>
    <Citation />
  </div>
</Layout>
