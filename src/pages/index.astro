---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Figure from "../components/Figure.astro";
import PresentationFigure from "../components/PresentationFigure.astro";
import Comparison from "../components/Comparison.astro";
import Citation from "../components/Citation.astro";
import MediaCredit from "../components/MediaCredit.astro";
import site from "../data/site.json";
import narrative from "../data/narrative.json";
import { asset } from "../data/paths";
const related = narrative.relatedWork.externalReference;
const contents = [
  ["problem", "Problem"], ["related-work", "Existing work"],
  ["gap", "Research gap"], ["method", "Our method"],
  ["experiments", "Experiments"], ["results", "Results"], ["conclusion", "Conclusion"],
];
---

<Layout>
  <Hero />
  <div class="container">
    <nav class="research-nav" aria-label="Research story">
      <p class="eyebrow">Explore the study</p>
      <ol>{contents.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ol>
    </nav>
    <section class="section" id="problem" aria-labelledby="problem-title">
      <div class="section-heading">
        <p class="eyebrow">{narrative.problem.title}</p>
        <h2 id="problem-title">{narrative.problem.heading}</h2>
        <p class="lead">{narrative.problem.intro}</p>
      </div>
      <p class="eyebrow">{narrative.problem.program.title}</p>
      <h3>{narrative.problem.program.heading}</h3>
      <p>{narrative.problem.program.intro}</p>
      <div class="approach-grid">
        {narrative.problem.program.pillars.map((pillar) => <div><>
          <span class="dna-letter" aria-hidden="true">{pillar.letter}</span>
          <h3>{pillar.title}</h3><p>{pillar.text}</p>
        </></div>)}
      </div>
      <p class="source-note">{narrative.problem.program.scopeNote}</p>
      <div class="presentation-grid">
        <PresentationFigure id="urban-digital-twin" />
        <PresentationFigure id="urban-wind-field" />
      </div>
    </section>
    <section class="section" id="related-work" aria-labelledby="related-work-title">
      <div class="section-heading">
        <p class="eyebrow">{narrative.relatedWork.title}</p>
        <h2 id="related-work-title">{narrative.relatedWork.heading}</h2>
        <p class="lead">{narrative.relatedWork.intro}</p>
      </div>
      <div class="approach-grid">
        {narrative.relatedWork.approaches.map((item) => <div><><h3>{item.title}</h3><p>{item.text}</p></></div>)}
      </div>
      <aside class="related-study" aria-labelledby="geowind-title">
        <p class="eyebrow">{related.attribution}</p>
        <h3 id="geowind-title">{related.title}</h3>
        <div class="study-comparison">
          <p>{related.summary}</p><p>{related.distinction}</p>
        </div>
        <p class="fine-print">{related.scopeNote}</p>
        <p><a href={related.htmlUrl}>Read GeoWind2Plan in HTML</a> · <a href={related.pdfUrl}>Read the GeoWind2Plan preprint (PDF, 31 pages)</a></p>
      </aside>
    </section>
    <section class="section" id="gap" aria-labelledby="gap-title">
      <div class="section-heading">
        <p class="eyebrow">{narrative.gap.title}</p>
        <h2 id="gap-title">{narrative.gap.heading}</h2>
        <p class="lead">{narrative.gap.intro}</p>
      </div>
      <p class="research-question">{narrative.gap.question}</p>
      <p class="source-note">{narrative.gap.scopeNote}</p>
      <dl class="stats">{site.stats.map((stat) => <div><><dt>{stat.label}</dt><dd>{stat.value}</dd></></div>)}</dl>
    </section>
    <section class="section" id="method" aria-labelledby="method-title">
      <div class="section-heading">
        <p class="eyebrow">{narrative.method.title}</p>
        <h2 id="method-title">{narrative.method.heading}</h2>
        <p class="lead">{narrative.method.intro}</p>
      </div>
      <ol class="steps">{narrative.method.steps.map((step, i) => <li><>
        <span class="step-number" aria-hidden="true">0{i + 1}</span>
        <h3>{step.title}</h3><p>{step.text}</p>
      </></li>)}</ol>
      <Figure id={site.methodFigure} compact />
      <a class="text-link" href={asset("paper/")}>Read the research guide <span aria-hidden="true">→</span></a>
    </section>
    <section class="section" id="experiments" aria-labelledby="experiments-title">
      <div class="section-heading">
        <p class="eyebrow">{narrative.experiments.title}</p>
        <h2 id="experiments-title">{narrative.experiments.heading}</h2>
        <p class="lead">{narrative.experiments.intro}</p>
      </div>
      <dl class="protocol-grid">{narrative.experiments.protocol.map((item) => <div><><dt>{item.title}</dt><dd>{item.text}</dd></></div>)}</dl>
      <p class="evidence-note">{narrative.experiments.metricNote}</p>
      <Figure id="wind" compact />
      <p class="source-note">{narrative.experiments.scopeNote}</p>
    </section>
    <section class="section" id="results" aria-labelledby="results-title">
      <div class="section-heading">
        <p class="eyebrow">{narrative.results.title}</p>
        <h2 id="results-title">{narrative.results.heading}</h2>
        <p class="lead">{narrative.results.intro}</p>
      </div>
      <div class="highlights">{site.highlights.map((item) => <div><>
        <h3>{item.label}</h3>
        <p class="numeric-pair"><><span>{item.before}</span><span aria-hidden="true">→</span><span class="sr-only">to</span><strong>{item.after}</strong></></p>
        <p>{item.note}</p>
      </></div>)}</div>
      <p class="evidence-note">{site.resultNote}</p>
      <Comparison />
      <div class="finding-grid">{narrative.results.keyFindings.slice(1).map((item) => <div><><h3>{item.title}</h3><p>{item.text}</p></></div>)}</div>
      <p>{narrative.results.comparisonNote}</p>
      <a class="text-link" href={asset("results/")}>Read all four result tables and download CSV data <span aria-hidden="true">→</span></a>
    </section>
    <section class="section" id="conclusion" aria-labelledby="conclusion-title">
      <div class="section-heading">
        <p class="eyebrow">{narrative.conclusion.title}</p>
        <h2 id="conclusion-title">{narrative.conclusion.heading}</h2>
        <p class="lead">{narrative.conclusion.intro}</p>
      </div>
      <ul>{narrative.conclusion.limitations.map((item) => <li>{item}</li>)}</ul>
      <p class="source-note">{narrative.conclusion.futureWork}</p>
    </section>
    <section class="section resources" aria-labelledby="resources-title">
      <div class="section-heading">
        <p class="eyebrow">Continue exploring</p>
        <h2 id="resources-title">Paper, data & implementation.</h2>
      </div>
      <div class="resource-grid">
        <a class="resource-card" href={site.paperUrl}><span class="eyebrow">Publication ↗</span><h3>Published paper</h3><p>{site.publication}</p></a>
        <a class="resource-card" href={asset("results/")}><span class="eyebrow">HTML + CSV →</span><h3>Results & original figures</h3><p>Read the numeric comparisons as accessible tables or download the data.</p></a>
        <a class="resource-card" href={site.repo}><span class="eyebrow">GitHub ↗</span><h3>{site.repoLabel}</h3><p>{site.repoNote}</p></a>
      </div>
    </section>
    <Citation />
    <div class="section"><MediaCredit /></div>
  </div>
</Layout>
