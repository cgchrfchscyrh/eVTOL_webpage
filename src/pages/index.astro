---
import Vision from "../components/Vision.astro";
import stories from "../data/vision-stories.json";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Figure from "../components/Figure.astro";
import PresentationFigure from "../components/PresentationFigure.astro";
import MotionClip from "../components/MotionClip.astro";
import Citation from "../components/Citation.astro";
import MediaCredit from "../components/MediaCredit.astro";
---

<Layout title={stories.flight.headline}>
  <Hero />
  <div class="container visual-research">
    <section class="section abstract-section" id="abstract" aria-labelledby="abstract-title">
      <h2 id="abstract-title">One flight, competing demands.</h2>
      <p class="section-intro">A maneuver around a city block must account for wind, nearby buildings, and the people on board and below. A shorter or faster path may not be the best one for every objective. We study this local planning problem through reinforcement learning for simulated urban flight.</p>
      <MotionClip id="urban-intersection" />
    </section>
    <section class="section" id="method" aria-labelledby="method-title">
      <h2 id="method-title">Learn with the city in the loop.</h2>
      <p class="section-intro">City geometry and local wind inform a modified PPO policy. Its reward connects the aircraft, its passengers, and the surrounding environment.</p>
      <Figure id="framework" concise caption="Learning motion with multiple flight objectives." />
      <div class="method-visuals">
        <MotionClip id="urban-corridor" />
        <div class="presentation-grid">
          <PresentationFigure id="urban-digital-twin" concise />
          <PresentationFigure id="urban-wind-field" concise />
        </div>
      </div>
    </section>
    <section class="section" id="results" aria-labelledby="results-title">
      <h2 id="results-title">Make the trade-offs visible.</h2>
      <p class="section-intro">In the all-objective comparison, the policy improves energy use, comfort, and modeled noise, with trade-offs in safety scores and travel time.</p>
      <p class="scope-note">Evidence is limited to simulated flight. Takeoff, landing, and real-aircraft validation are outside the study; the animation illustrates the setting rather than experimental results.</p>
      <MotionClip id="urban-facade" />
    </section>
    <Vision project="flight" />
    <Citation />
    <aside class="related-reading" id="related-work" aria-label="Related reading">
      <p><strong>Related reading</strong> · <a href="https://arxiv.org/html/2609.36056v1">GeoWind2Plan</a>, an independent study of wind-aware aerial planning.</p>
    </aside>
    <details class="media-notes">
      <summary>Media descriptions & credits</summary>
      <MediaCredit />
    </details>
  </div>
</Layout>
